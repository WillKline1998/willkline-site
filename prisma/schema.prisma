// Data model for willkline.com — see docs/PLAN.md for how each model maps to a feature.
// Postgres everywhere: local Homebrew Postgres in dev, Neon in production.

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // No native query engine: queries run in JS through the pg driver adapter
  // (src/lib/db.ts). Nothing platform-specific to bundle on Vercel.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection on Neon; locally it's the same DB.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- People ----------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  handle       String?    @unique // public @handle for Wall members (willkline.net/wall/u/<handle>)
  role         String     @default("MEMBER") // "ADMIN" | "MEMBER" (strings, not enums, keep migrations simple)
  passwordHash String?
  createdAt    DateTime   @default(now())
  wallPosts    WallPost[]
  saves        Save[]
  sessions     Session[]
  reports      WallReport[]
  resets       PasswordReset[]
}

// One-time "forgot password" links. Only a hash of the token is stored, like
// sessions, so a database leak can't be used to reset anyone's password.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Login sessions. The cookie holds a random token; only its SHA-256 hash is
// stored, so a leaked database can't be used to log in.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Every file saved through src/lib/storage.ts. /uploads/[key] serves these.
model Upload {
  key       String   @id
  fileName  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

// ---------- Will's content (admin-editable, M2/M3) ----------

model Album {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  kind        String   @default("ALBUM") // "ALBUM" | "EP" | "SINGLE" | "COMPOSITION" | "PROJECT"
  description String   @default("")
  year        Int?
  coverUrl    String?
  links       String   @default("{}") // JSON: { spotify?, bandcamp?, soundcloud?, youtube?, hyperfollow?, ... }
  sortOrder   Int      @default(0)    // lower = shown first
  published   Boolean  @default(false)
  tracks      Track[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Track list for a release (display only: a numbered list on /music/[slug]).
model Track {
  id          String @id @default(cuid())
  albumId     String
  album       Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  title       String
  position    Int    // 1-based order on the release
  durationSec Int?   // optional; shown as m:ss

  @@index([albumId, position])
}

// Writing (admin-only blog). `body` is Markdown; a line holding only a
// YouTube/Spotify/… link becomes a player. One optional lead picture OR video.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  body        String    // Markdown
  mediaKind   String?   // "IMAGE" | "VIDEO" | null
  mediaUrl    String?   // IMAGE: /uploads/<key>; VIDEO: video page URL
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Media page (admin-only posting): uploaded photos and links to web-hosted
// video (YouTube, Vimeo, …). Videos are never hosted here.
model MediaItem {
  id        String   @id @default(cuid())
  kind      String   // "PHOTO" | "VIDEO"
  title     String   @default("") // optional title / subtitle
  url       String   // PHOTO: /uploads/<key>; VIDEO: the video page URL
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Downloadable documents (résumé, CV, anything else). Will uploads/replaces
// these from the admin page; the CV page lists whatever is published.
model Document {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  fileKey     String   // name in storage (see src/lib/storage.ts)
  fileName    String   // original filename, used for the download
  mimeType    String   @default("application/octet-stream")
  size        Int      @default(0)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Lab: experiments and projects. `body` is Markdown for the project's own page.
model LabProject {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("") // one-line summary for the card
  body        String   @default("")
  status      String   @default("IDEA") // "IDEA" | "BUILDING" | "LIVE"
  tech        String   @default("") // comma-separated, e.g. "Next.js, Web Audio"
  url         String?  // live demo
  repoUrl     String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Free-form editable text blocks (home bio, CV summary, etc.)
model SiteSetting {
  key   String @id
  value String
}

// ---------- Home page bulletin board ----------
// Will (admin) posts anything here: shows, releases, news, notes.
// Each notice can point deeper into the site (or off-site).

model Notice {
  id        String    @id @default(cuid())
  kind      String    @default("NOTE") // "SHOW" | "RELEASE" | "NEWS" | "NOTE"
  title     String
  body      String    @default("") // Markdown
  eventDate DateTime? // for shows / release dates
  venue     String?   // for shows
  linkHref  String?   // internal path ("/music/becoming") or external URL
  linkLabel String?
  pinned    Boolean   @default(false)
  published Boolean   @default(true)
  media     NoticeMedia[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Things attached to a notice, rendered faithfully: images inline,
// video/audio as real players (YouTube, Vimeo, Spotify, SoundCloud),
// documents as a preview + download, anything else as a link card.
model NoticeMedia {
  id       String @id @default(cuid())
  noticeId String
  notice   Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  kind     String // "IMAGE" | "EMBED" | "FILE" | "LINK"
  url      String
  caption  String @default("")
  position Int    @default(0)
}

// ---------- Inspiration Wall (M4) ----------

// Inspiration Wall: members share links to art/music they love; others save them.
model WallPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      String   // "MUSIC" | "VIDEO" | "ART" | "OTHER" (derived from the URL, editable)
  title     String
  url       String
  note      String   @default("") // why it inspires them
  imageUrl  String?  // optional uploaded preview (/uploads/<key>), resized on upload
  hidden    Boolean  @default(false) // admin moderation
  reports   Int      @default(0)
  createdAt DateTime @default(now())
  saves     Save[]
  flags     WallReport[]

  @@index([createdAt])
}

// One report per person per post, so a single account can't hide things.
model WallReport {
  userId     String
  wallPostId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallPost   WallPost @relation(fields: [wallPostId], references: [id], onDelete: Cascade)

  @@id([userId, wallPostId])
}

// A user's personal collection = the WallPosts they've saved.
model Save {
  userId     String
  wallPostId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallPost   WallPost @relation(fields: [wallPostId], references: [id], onDelete: Cascade)

  @@id([userId, wallPostId])
}
